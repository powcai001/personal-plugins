#!/usr/bin/env python3
"""Stop hook：到期则轮换横幅提醒 1 分钟；不自动 ack（等用户手动 done）；异常静默退出 0。"""
import json
import os
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

import health_lib  # noqa: E402


def main_hook():
    try:
        sys.stdin.read()  # 丢弃 hook 输入
    except Exception:  # noqa: BLE001
        pass
    try:
        now = int(time.time())
        with health_lib.state_lock():
            s = health_lib.load_state()
            if not s:
                return 0
            c = health_lib.compute(s, now)
            if not c["due"]:
                return 0
            seq = s.get("banner_seq") or 0
            text = health_lib.banner_text(c, seq=seq)
            ns = dict(s)
            if not s.get("banner_seq_at"):
                ns["banner_seq_at"] = now   # 首次弹出：开始 1 分钟展示窗口
            ns["banner_seq"] = seq + 1      # 每次弹窗都换文案；last_ack 不动（等手动 done）
            health_lib.save_state(ns)
            if now - ns["banner_seq_at"] >= health_lib.BANNER_SHOW_S:
                return 0                    # 展示窗口已过：静默，不再打扰
        print(json.dumps({"systemMessage": text}, ensure_ascii=False))
    except Exception:  # noqa: BLE001  hook 绝不阻塞会话
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main_hook())
